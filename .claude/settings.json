{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/edit.sh\"",
						"timeout": 60,
						"statusMessage": "Formatting and linting"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/stop.sh\"",
						"timeout": 300,
						"statusMessage": "Clippy, tests, gdlint and sumi verify"
					}
				]
			}
		]
	}
}
