; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot-mruby"
config/features=PackedStringArray("4.7")

[mruby]

loader/root_directories=PackedStringArray("res://src", "res://integration/loader/namesakes")
test/directories=PackedStringArray("res://test", "res://integration/runner/order", "res://integration/runner/skip", "res://integration/runner/orphan", "res://integration/runner/failures/assertion", "res://integration/runner/failures/error", "res://integration/runner/failures/syntax", "res://integration/runner/failures/delay", "res://integration/runner/failures/missing", "res://integration/loader/latecomers", "res://integration/loader/failures/tripwire")
