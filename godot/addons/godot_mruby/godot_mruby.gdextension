[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

; Three libraries per platform: the editor loads the one with its tools and the
; test runner, export templates one without. The editor's and the debug
; template's carry mruby's debug hook, the release template's does not. A key
; wins with more tags, so each but the release one takes a second. The build
; that fills bin/ decides the Cargo profile (debug for local development,
; release for distribution). macOS ships universal dylibs.
[libraries]
macos.editor =                  "bin/libgodot_mruby.macos.editor.dylib"
macos.template_debug =          "bin/libgodot_mruby.macos.template_debug.dylib"
macos =                         "bin/libgodot_mruby.macos.template.dylib"
linux.x86_64.editor =           "bin/libgodot_mruby.linux.x86_64.editor.so"
linux.x86_64.template_debug =   "bin/libgodot_mruby.linux.x86_64.template_debug.so"
linux.x86_64 =                  "bin/libgodot_mruby.linux.x86_64.template.so"
linux.arm64.editor =            "bin/libgodot_mruby.linux.arm64.editor.so"
linux.arm64.template_debug =    "bin/libgodot_mruby.linux.arm64.template_debug.so"
linux.arm64 =                   "bin/libgodot_mruby.linux.arm64.template.so"
windows.x86_64.editor =         "bin/godot_mruby.windows.x86_64.editor.dll"
windows.x86_64.template_debug = "bin/godot_mruby.windows.x86_64.template_debug.dll"
windows.x86_64 =                "bin/godot_mruby.windows.x86_64.template.dll"
windows.arm64.editor =          "bin/godot_mruby.windows.arm64.editor.dll"
windows.arm64.template_debug =  "bin/godot_mruby.windows.arm64.template_debug.dll"
windows.arm64 =                 "bin/godot_mruby.windows.arm64.template.dll"
