# Godot; the extension list is kept so a run loads the addon without the
# editor having to discover it first
godot/.godot/*
!godot/.godot/extension_list.cfg
godot/addons/godot_mruby/bin/

# Rust
rust/target/

# The mruby source and archives `rake beni:build` downloads and builds
/vendor/

# Addon packages `rake addon:package` writes
/pkg/

# Local working notes, kept out of the repository
/tmp/
